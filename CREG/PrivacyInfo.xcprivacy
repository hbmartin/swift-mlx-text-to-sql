<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- CREG answers entirely on device and has no runtime networking. Nothing
	     leaves the iPhone unless the user explicitly emails or shares a
	     Support Bundle. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- First-party code uses no required-reason APIs: no UserDefaults, file
	     timestamps, disk space, system boot time, or active keyboard access.
	     Dependencies that do (GRDB, ComposableArchitecture, Sharing, Crypto)
	     declare their own manifests in their resource bundles. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
