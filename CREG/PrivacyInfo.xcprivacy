<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- CREG answers entirely on device and has no runtime networking. Nothing
	     leaves the iPhone unless the user explicitly emails or shares a
	     Support Bundle. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- First-party code persists the appearance preference through
	     UserDefaults (Sharing's appStorage), declared below with CA92.1:
	     app-private storage only. No other required-reason APIs are used
	     directly -- no file timestamps, disk space, system boot time, or
	     active keyboard access. Dependencies that use them (GRDB,
	     ComposableArchitecture, Sharing, Crypto) declare their own manifests
	     in their resource bundles. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
